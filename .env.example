# ============================================================================
# NEXUS â€” Environment Configuration (example)
# Copy to .env and fill in values. Never commit .env.
# ============================================================================

# --- Core ---
NEXUS_ENV=development
NEXUS_SECRET_KEY=change-me-to-a-long-random-string
# Bootstrap users (created on first run when users table is empty)
NEXUS_ADMIN_PASSWORD=
NEXUS_ANALYST_PASSWORD=
LOG_LEVEL=INFO
API_PREFIX=/api/v1

# --- Database (SQLite by default; set postgres URL for production) ---
# DATABASE_URL=postgresql+asyncpg://nexus:nexus@localhost:5432/nexus
DATABASE_URL=sqlite+aiosqlite:///./nexus_storage/nexus.db

# --- Redis (optional; in-process queue used when absent) ---
# REDIS_URL=redis://localhost:6379/0
REDIS_URL=

# --- LLM providers (any subset; local heuristic provider used as fallback) ---
LLM_PROVIDER=local
# LLM_PROVIDER=openai
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.0-flash
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# --- Embeddings ---
EMBEDDING_PROVIDER=local
# EMBEDDING_PROVIDER=openai
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=256

# --- Vector store: memory | pgvector ---
VECTOR_STORE=memory
# PGVECTOR_URL=postgresql+asyncpg://nexus:nexus@localhost:5432/nexus

# --- Agent runtime ---
MAX_AGENT_ITERATIONS=8
MAX_RETRIES=3
AGENT_STEP_TIMEOUT_SECONDS=120
TASK_TIMEOUT_SECONDS=600

# --- SQL engine ---
SQL_TIMEOUT_SECONDS=20
SQL_MAX_ROWS=500

# --- Python sandbox ---
SANDBOX_TIMEOUT_SECONDS=15
SANDBOX_MEMORY_MB=256

# --- Ingestion ---
MAX_FILE_SIZE_MB=25
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# --- Security ---
RATE_LIMIT_PER_MINUTE=60
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Comma-separated API keys accepted as Bearer tokens (dev convenience)
API_KEYS=

# --- HTTP tool allowlist (comma-separated hostnames) ---
HTTP_TOOL_ALLOWLIST=localhost,127.0.0.1

# --- Observability ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Frontend build (injected at build time) ---
VITE_API_BASE_URL=/api/v1
